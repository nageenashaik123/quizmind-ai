# ── Server ──────────────────────────────────────────────────
PORT=5000

# ── PostgreSQL ───────────────────────────────────────────────
# Local:      postgresql://postgres:YOUR_PASSWORD@localhost:5432/quizmind
# Neon (prod):postgresql://user:password@ep-xxx.region.neon.tech/quizmind?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/quizmind

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── AI — Gemini (primary) ────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Key format: AQ.Ab8RN6... (new Auth key format as of 2026)
GEMINI_API_KEY=AQ.your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── AI — Groq (fallback #1) ──────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── AI — Ollama (fallback #2, local) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── Email — Gmail App Password ───────────────────────────────
# Get from: Google Account → Security → 2-Step Verification → App Passwords
# App password is 16 chars with spaces, e.g.: abcd efgh ijkl mnop
EMAIL_API_KEY=your_gmail_app_password_here
EMAIL_FROM=your_gmail@gmail.com
